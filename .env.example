# Copy this file to ".env" and fill in your values.
# On Windows:  copy .env.example .env
# On Mac/Linux: cp .env.example .env
# Then load it before running:  set -a; source .env; set +a   (or use any env loader)

# From developers.facebook.com -> your app -> Settings -> Basic
FB_APP_ID=
FB_APP_SECRET=

# Must EXACTLY match the "Valid OAuth Redirect URI" you set in
# Facebook Login -> Settings. Keep the default if you run on port 5000.
FB_REDIRECT_URI=http://localhost:5000/api/callback

# Any random string; used to sign the login session cookie.
FLASK_SECRET=change-this-to-something-random

# OPTIONAL — password for the dashboard. Anyone who opens the app's page
# will be asked for this first (a small form at /gate).
# Leave empty on your own laptop (localhost needs no password), but ALWAYS
# set it when hosting the app on a public server.
DASHBOARD_PASSWORD=

# OPTIONAL — seconds between full checks of all watched posts in auto
# mode. Default is 120 (every 2 minutes). Minimum 30.
WATCH_INTERVAL_SEC=120

# HOSTING ONLY — platforms like Render/Railway set PORT automatically and
# the app then listens on 0.0.0.0:$PORT. You don't set this yourself.
# Locally (no PORT set) the app runs at http://localhost:5000
